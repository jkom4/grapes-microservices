<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   https://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.4.xsd">

    <!-- Table paiement -->
    <changeSet id="1" author="grapes">
        <createTable tableName="paiement">
            <column name="id_paiement" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_transaction" type="BIGINT"/>
            <column name="nom_marchand" type="VARCHAR(100)"/>
            <column name="date_heure" type="DATETIME"/>
            <column name="montant" type="DECIMAL(10,2)"/>
            <column name="statut" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>

    <!-- Table log_paiement -->
    <changeSet id="2" author="grapes">
        <createTable tableName="log_paiement">
            <column name="id_log" type="BIGINT">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="id_paiement" type="BIGINT"/>
            <column name="date_heure_log" type="DATETIME"/>
            <column name="type_evenement" type="VARCHAR(100)"/>
            <column name="description" type="TEXT"/>
            <column name="localisation_ip" type="VARCHAR(45)"/>
        </createTable>
    </changeSet>

    <!-- Table marchand -->
    <changeSet id="3" author="grapes">
        <createTable tableName="marchand">
            <column name="nom_marchand" type="VARCHAR(100)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="secteur_activite" type="VARCHAR(100)"/>
            <column name="adresse_marchand" type="VARCHAR(255)"/>
            <column name="numero_tva" type="VARCHAR(50)"/>
            <column name="date_inscription" type="DATE"/>
            <column name="statut_marchand" type="VARCHAR(20)"/>
        </createTable>
    </changeSet>

    <!-- Foreign Key: paiement.id_transaction -> transaction.id -->
    <changeSet id="4" author="grapes">
        <addForeignKeyConstraint
                baseTableName="paiement"
                baseColumnNames="id_transaction"
                referencedTableName="transaction"
                referencedColumnNames="id"
                constraintName="fk_paiement_transaction"/>
    </changeSet>

    <!-- Foreign Key: paiement.nom_marchand -> marchand.nom_marchand -->
    <changeSet id="5" author="grapes">
        <addForeignKeyConstraint
                baseTableName="paiement"
                baseColumnNames="nom_marchand"
                referencedTableName="marchand"
                referencedColumnNames="nom_marchand"
                constraintName="fk_paiement_marchand"/>
    </changeSet>

    <!-- Foreign Key: log_paiement.id_paiement -> paiement.id_paiement -->
    <changeSet id="6" author="grapes">
        <addForeignKeyConstraint
                baseTableName="log_paiement"
                baseColumnNames="id_paiement"
                referencedTableName="paiement"
                referencedColumnNames="id_paiement"
                constraintName="fk_logpaiement_paiement"/>
    </changeSet>

</databaseChangeLog>
