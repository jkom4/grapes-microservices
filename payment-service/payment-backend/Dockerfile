FROM maven:3.9.6-eclipse-temurin-21 AS builder
WORKDIR /app
COPY . .
RUN mvn clean install -DskipTests


FROM eclipse-temurin:21-jdk-alpine
LABEL authors="jkom"
WORKDIR /app
COPY --from=builder /app/target/*.jar app.jar
#COPY src/main/resources/keystore /app/keystore

# Set environment variables
ENV PAYMENT_SERVICE_PORT=${PAYMENT_SERVICE_PORT}
ENV PAYMENT_FRONT_END_URL=${PAYMENT_FRONT_END_URL}
ENV PAYMENT_SERVER_SSL_ENABLED=${PAYMENT_SERVER_SSL_ENABLED}
ENV PAYMENT_SERVER_SSL_KEY_STORE_TYPE=${PAYMENT_SERVER_SSL_KEY_STORE_TYPE}

ENV PAYMENT_PASSWORD_SALT=${PAYMENT_PASSWORD_SALT}

ENV PAYMENT_DB_URL=${PAYMENT_DB_URL}
ENV PAYMENT_DB_USERNAME=${PAYMENT_DB_USERNAME}
ENV PAYMENT_DB_PASSWORD=${PAYMENT_DB_PASSWORD}

ENV PAYMENT_TWILIO_ACCOUNT_SID=${PAYMENT_TWILIO_ACCOUNT_SID}
ENV PAYMENT_TWILIO_AUTH_TOKEN=${PAYMENT_TWILIO_AUTH_TOKEN}
ENV PAYMENT_TWILIO_PHONE_NUMBER=${PAYMENT_TWILIO_PHONE_NUMBER}

ENV PAYMENT_BANK_ACCOUNT_NUMBER=${PAYMENT_BANK_ACCOUNT_NUMBER}
ENV PAYMENT_BANK_CLIENT_PASSWORD=${PAYMENT_BANK_CLIENT_PASSWORD}
ENV PAYMENT_BANK_CLIENT_PHONE=${PAYMENT_BANK_CLIENT_PHONE}

ENV PAYMENT_KEYSTORE_ACS_PATH=${PAYMENT_KEYSTORE_ACS_PATH}
ENV PAYMENT_KEYSTORE_ACS_PASSWORD=${PAYMENT_KEYSTORE_ACS_PASSWORD}
ENV PAYMENT_KEYSTORE_ACS_KEY_ALIAS=${PAYMENT_KEYSTORE_ACS_KEY_ALIAS}
ENV PAYMENT_KEYSTORE_ACS_KEY_PASSWORD=${PAYMENT_KEYSTORE_ACS_KEY_PASSWORD}

ENV PAYMENT_KEYSTORE_ACQ_PATH=${PAYMENT_KEYSTORE_ACQ_PATH}
ENV PAYMENT_KEYSTORE_ACQ_PASSWORD=${PAYMENT_KEYSTORE_ACQ_PASSWORD}
ENV PAYMENT_KEYSTORE_ACQ_KEY_ALIAS=${PAYMENT_KEYSTORE_ACQ_KEY_ALIAS}
ENV PAYMENT_KEYSTORE_ACQ_KEY_PASSWORD=${PAYMENT_KEYSTORE_ACQ_KEY_PASSWORD}

ENV PAYMENT_KEYSTORE_CLIENT_PATH=${PAYMENT_KEYSTORE_CLIENT_PATH}
ENV PAYMENT_KEYSTORE_CLIENT_PASSWORD=${PAYMENT_KEYSTORE_CLIENT_PASSWORD}
ENV PAYMENT_KEYSTORE_CLIENT_ALIAS=${PAYMENT_KEYSTORE_CLIENT_ALIAS}
ENV PAYMENT_KEYSTORE_CLIENT_KEY_PASSWORD=${PAYMENT_KEYSTORE_CLIENT_KEY_PASSWORD}

ENV PAYMENT_TRUSTSTORE_ACS_PATH=${PAYMENT_TRUSTSTORE_ACS_PATH}
ENV PAYMENT_TRUSTSTORE_ACS_PASSWORD=${PAYMENT_TRUSTSTORE_ACS_PASSWORD}
ENV PAYMENT_TRUSTSTORE_ACS_CLIENT_ALIAS=${PAYMENT_TRUSTSTORE_ACS_CLIENT_ALIAS}
ENV PAYMENT_TRUSTSTORE_ACS_ACQ_ALIAS=${PAYMENT_TRUSTSTORE_ACS_ACQ_ALIAS}

ENV PAYMENT_TRUSTSTORE_ACQ_PATH=${PAYMENT_TRUSTSTORE_ACQ_PATH}
ENV PAYMENT_TRUSTSTORE_ACQ_PASSWORD=${PAYMENT_TRUSTSTORE_ACQ_PASSWORD}
ENV PAYMENT_TRUSTSTORE_ACQ_ACS_ALIAS=${PAYMENT_TRUSTSTORE_ACQ_ACS_ALIAS}

ENV PAYMENT_TRUSTSTORE_CLIENT_PATH=${PAYMENT_TRUSTSTORE_CLIENT_PATH}
ENV PAYMENT_TRUSTSTORE_CLIENT_PASSWORD=${PAYMENT_TRUSTSTORE_CLIENT_PASSWORD}
ENV PAYMENT_TRUSTSTORE_CLIENT_ACS_ALIAS=${PAYMENT_TRUSTSTORE_CLIENT_ACS_ALIAS}
ENV PAYMENT_TRUSTSTORE_CLIENT_ACQ_ALIAS=${PAYMENT_TRUSTSTORE_CLIENT_ACQ_ALIAS}

ENV PAYMENT_PORT_ACS=${PAYMENT_PORT_ACS}
ENV PAYMENT_PORT_ACS_MONEY=${PAYMENT_PORT_ACS_MONEY}
ENV PAYMENT_PORT_ACQ=${PAYMENT_PORT_ACQ}


ENV RABBITMQ_HOST=${RABBITMQ_HOST}
ENV RABBITMQ_PORT=${RABBITMQ_PORT}
ENV RABBITMQ_USER=${RABBITMQ_USER}
ENV RABBITMQ_PASSWORD=${RABBITMQ_PASSWORD}

ENV REDIS_HOST=${REDIS_HOST}
ENV REDIS_PORT=${REDIS_PORT}
ENV REDIS_PASSWORD=${REDIS_PASSWORD}
EXPOSE ${PAYMENT_SERVICE_PORT}
ENTRYPOINT ["java", "-jar", "app.jar"]
