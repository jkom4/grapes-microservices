# 🌍 General config
ENVIRONMENT=development
LOG_LEVEL=debug


#  API Gateway
GATEWAY_PORT=8090
AUTH_SERVICE_URI=http://localhost:8091
SALES_SERVICE_URI=http://localhost:8092
PAYMENT_SERVICE_URI=http://localhost:8093
CHAT_SERVICE_URI=http://localhost:8094
DATA_MINING_SERVICE_URI=http://localhost:8095
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=


# 🔐 Authentication Service
AUTH_SERVICE_PORT=8091
TOKEN_EXPIRATION=3600  # 1 hour
AUTH_MONGO_URI=
AUTH_MONGO_DB=db_auth
GRAPES_AES_KEY=
GRAPES_SENDGRIP_API_SECRET=
GRAPES_TWILIO_API_SECRET=
GRAPES_TWILIO_SID=
TWILIO_FROM_NUMBER=
COMPANY_MAIL=
GRAPES_JWT_SECRET_KEY=

# 📦 Sales Service
SALES_SERVICE_PORT=8092
SALES_DB_URL=
SALES_DB_USER=
SALES_DB_PASSWORD=

# 💳 Payment Service
PAYMENT_SERVICE_PORT=8093
PAYMENT_DB_URL=
PAYMENT_DB_USER=
PAYMENT_DB_PASSWORD=

# 💳 Chat Service
CHAT_SERVICE_PORT=8094
CHAT_MONGO_URI=
CHAT_MONGO_DB=db_chat


# 📊 Database

# MariaDB
DB_PORT=3306
DB_USER=
DB_PASSWORD=

# MongoDB
MONGO_PORT=27017
MONGO_USER=
MONGO_PASSWORD=

# 🐰 Message Broker (RabbitMQ)
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_USER=
RABBITMQ_PASSWORD=

# 📈 Monitoring (Prometheus & Grafana)
PROMETHEUS_PORT=
GRAFANA_PORT=

# 🛠️ SonarQube (Code quality)
SONARQUBE_HOST=http://localhost:9000
SONARQUBE_TOKEN=

# ☁️ Oracle Cloud (OCIR)
ORACLE_REGION_ID=null
ORACLE_TENANCY_NAMESPACE=null
