CHAT_SERVICE_PORT=8094
CHAT_SERVICE_HOST=chat-service
CHAT_MONGO_URI=
CHAT_MONGO_DB=db_chat
CHAT_WEBSOCKET_PATH=/ws
CHAT_MESSAGE_HISTORY_LIMIT=100



