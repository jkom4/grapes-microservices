PAYMENT_KEYSTORE_ACS_KEY_ALIAS=acs
PAYMENT_KEYSTORE_ACS_KEY_PASSWORD=

# ACQ Server Keystore
PAYMENT_KEYSTORE_ACQ_PATH=payment-service/payment-backend/src/main/resources/keystore/acq_keystore.jks
PAYMENT_KEYSTORE_ACQ_PASSWORD=
PAYMENT_KEYSTORE_ACQ_KEY_ALIAS=acq
PAYMENT_KEYSTORE_ACQ_KEY_PASSWORD=

# Client/Backend Keystore
