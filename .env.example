PAYMENT_TRUSTSTORE_ACS_CLIENT_ALIAS=client_trusted
PAYMENT_TRUSTSTORE_ACS_ACQ_ALIAS=acq_trusted

PAYMENT_TRUSTSTORE_ACQ_PATH=payment-service/payment-backend/src/main/resources/keystore/acq_truststore.jks
PAYMENT_TRUSTSTORE_ACQ_PASSWORD=
PAYMENT_TRUSTSTORE_ACQ_ACS_ALIAS=acs_trusted

PAYMENT_TRUSTSTORE_CLIENT_PATH=payment-service/payment-backend/src/main/resources/keystore/client_truststore.jks
PAYMENT_TRUSTSTORE_CLIENT_PASSWORD=
PAYMENT_TRUSTSTORE_CLIENT_ACS_ALIAS=acs_trusted
