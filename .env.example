PAYMENT_KEYSTORE_CLIENT_PASSWORD=
PAYMENT_KEYSTORE_CLIENT_ALIAS=client
PAYMENT_KEYSTORE_CLIENT_KEY_PASSWORD=

# 🔒 Truststore Configurations
PAYMENT_TRUSTSTORE_ACS_PATH=payment-service/payment-backend/src/main/resources/keystore/acs_truststore.jks
