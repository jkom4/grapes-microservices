PAYMENT_PORT_ACQ=8082

PAYMENT_FRONT_END_URL=localhost:3000

# 🔑 Keystore Configurations
# ACS Server Keystore
PAYMENT_KEYSTORE_ACS_PATH=payment-service/payment-backend/src/main/resources/keystore/acs_keystore.jks
