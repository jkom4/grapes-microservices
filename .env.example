# 🌍 General config
LOG_LEVEL=debug

# 🚀 API Gateway
GATEWAY_PORT=8090
GATEWAY_HOST=0.0.0.0
GATEWAY_CORS_ORIGINS=http://localhost:3000
GATEWAY_REQUEST_TIMEOUT=60000

# 🔐 Authentication Service
AUTH_SERVICE_PORT=8091
AUTH_SERVICE_HOST=auth-service
TOKEN_EXPIRATION=3600  # 1 hour
REFRESH_TOKEN_EXPIRATION=2592000  # 30 days
AUTH_MONGO_URI=
AUTH_MONGO_DB=db_auth
GRAPES_AES_KEY=
GRAPES_SENDGRIP_API_SECRET=
GRAPES_TWILIO_API_SECRET=
GRAPES_TWILIO_SID=
TWILIO_FROM_NUMBER=
COMPANY_MAIL=
GRAPES_JWT_SECRET_KEY=
MAX_REQUESTS_PER_MINUTE=
CHALLENGE_REQUEST_INTERVAL_IN_SECONDS=
CHALLENGE_VALIDITY_PERIOD_IN_SECONDS=
REQUIRED_AGE=
REDIS_PASSWORD=

# 📦 Sales Service
SALES_SERVICE_PORT=8092
SALES_SERVICE_HOST=sales-service
SALES_DB_URL=
SALES_DB_USER=
SALES_DB_PASSWORD=

# 💳 Payment Service

#######################################################################
PAYMENT_SERVICE_PORT=8093
PAYMENT_SERVICE_HOST=payment-service
PAYMENT_DB_HOST=localhost
PAYMENT_DB_PORT=3306
PAYMENT_DB_NAME=payment_db
FRONT_END_URL=
PAYMENT_DB_URL=
PAYMENT_DB_DRIVER=org.mariadb.jdbc.Driver
PAYMENT_DB_USER=
PAYMENT_DB_PASSWORD=


# Twilio Configuration (for Payment SMS)
PAYMENT_TWILIO_ACCOUNT_SID=
PAYMENT_TWILIO_AUTH_TOKEN=
PAYMENT_TWILIO_PHONE_NUMBER=


# Bank Account Details
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_ACCOUNT_PASSWORD=
PAYMENT_BANK_CLIENT_PASSWORD=
PAYMENT_BANK_CLIENT_PHONE=

# Security Configuration
PAYMENT_PASSWORD_SALT=

# Internal Server Ports
PAYMENT_PORT_ACS=8081
PAYMENT_PORT_ACS_MONEY=8083
PAYMENT_PORT_ACQ=8082

# Keystore Configurations
# ACS Server Keystore
PAYMENT_KEYSTORE_ACS_PATH=src/main/resources/keystore/acs_keystore.jks
PAYMENT_KEYSTORE_ACS_PASSWORD=
PAYMENT_KEYSTORE_ACS_KEY_ALIAS=acs
PAYMENT_KEYSTORE_ACS_KEY_PASSWORD=

# ACQ Server Keystore
PAYMENT_KEYSTORE_ACQ_PATH=src/main/resources/keystore/acq_keystore.jks
PAYMENT_KEYSTORE_ACQ_PASSWORD=
PAYMENT_KEYSTORE_ACQ_KEY_ALIAS=acq
PAYMENT_KEYSTORE_ACQ_KEY_PASSWORD=

# Client/Backend Keystore
PAYMENT_KEYSTORE_CLIENT_PATH=src/main/resources/keystore/client_keystore.jks
PAYMENT_KEYSTORE_CLIENT_PASSWORD=
PAYMENT_KEYSTORE_CLIENT_ALIAS=client
PAYMENT_KEYSTORE_CLIENT_KEY_PASSWORD=

# Truststore Configurations
PAYMENT_TRUSTSTORE_ACS_PATH=src/main/resources/keystore/acs_truststore.jks
PAYMENT_TRUSTSTORE_ACS_PASSWORD=
PAYMENT_TRUSTSTORE_ACS_CLIENT_ALIAS=client_trusted
PAYMENT_TRUSTSTORE_ACS_ACQ_ALIAS=acq_trusted

PAYMENT_TRUSTSTORE_ACQ_PATH=src/main/resources/keystore/acq_truststore.jks
PAYMENT_TRUSTSTORE_ACQ_PASSWORD=
PAYMENT_TRUSTSTORE_ACQ_ACS_ALIAS=acs_trusted

PAYMENT_TRUSTSTORE_CLIENT_PATH=src/main/resources/keystore/client_truststore.jks
PAYMENT_TRUSTSTORE_CLIENT_PASSWORD=
PAYMENT_TRUSTSTORE_CLIENT_ACS_ALIAS=acs_trusted
PAYMENT_TRUSTSTORE_CLIENT_ACQ_ALIAS=acq_trusted

# Redis Configuration for Payment
PAYMENT_CACHE_TYPE=redis

#######################################################################


