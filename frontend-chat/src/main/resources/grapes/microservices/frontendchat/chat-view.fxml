<?xml version="1.0" encoding="UTF-8"?>

<?import grapes.microservices.frontendchat.views.components.*?>
<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.effect.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<BorderPane maxHeight="-Infinity" maxWidth="-Infinity"
            minHeight="200.0" minWidth="0.0"
            prefHeight="600.0" prefWidth="800.0"
            stylesheets="@chat-view.css" xmlns="http://javafx.com/javafx/17.0.12"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="grapes.microservices.frontendchat.views.ChatViewController">
    <center>
        <SplitPane dividerPositions="0.06713426853707415, 0.49173346693386766" prefHeight="160.0" prefWidth="200.0" BorderPane.alignment="CENTER">
            <!--SIDE BAR-->
            <VBox styleClass="side-container" alignment="BOTTOM_CENTER" spacing="5.0" AnchorPane.bottomAnchor="0.0" AnchorPane.leftAnchor="0.0" AnchorPane.rightAnchor="0.0" AnchorPane.topAnchor="0.0">
                <ImageView fx:id="logoutButton" fitHeight="48.0" fitWidth="38.0" pickOnBounds="true" preserveRatio="true" styleClass="button-icon">
                    <Image url="@logout.png" />
                    <VBox.margin>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </VBox.margin>
                </ImageView>
            </VBox>
            <!--TOPIC LIST-->
            <TopicListFx styleClass="topic-zone" fx:id="topicListFx" />
            <!--CHAT-->
            <ChatFx fx:id="chatFx" />
        </SplitPane>
    </center>
   <opaqueInsets>
      <Insets />
   </opaqueInsets>
   <effect>
      <Blend />
   </effect>
</BorderPane>
