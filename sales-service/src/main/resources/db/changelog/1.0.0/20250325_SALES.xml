<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.6.xsd">

    <!-- 1. Table category -->
    <changeSet author="kilane dounia" id="1">
        <createTable tableName="category">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)"/>
            <column name="description" type="TEXT"/>
            <column name="picture_path" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

    <!-- 2. Table family -->
    <changeSet author="kilane dounia" id="2">
        <createTable tableName="family">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="name" type="VARCHAR(100)"/>
            <column name="description" type="TEXT"/>
        </createTable>
    </changeSet>

    <!-- 3. Table article -->
    <changeSet author="kilane dounia" id="3">
        <createTable tableName="article">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="category_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="family_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="name" type="VARCHAR(100)"/>
            <column name="description" type="TEXT"/>
            <column name="price_kg" type="DECIMAL(10,2)"/>
            <column name="price_unit" type="DECIMAL(10,2)"/>
            <column name="stock_kg" type="DECIMAL(10,2)"/>
            <column name="unit_stock" type="DECIMAL(10,2)"/>
            <column name="origin" type="VARCHAR(100)"/>
            <column name="picture_path" type="VARCHAR(255)"/>
        </createTable>
    </changeSet>

    <!-- 4. Table order -->
    <changeSet author="kilane dounia" id="4">
        <createTable tableName="order">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="code" type="INT"/>
            <column name="user_id" type="INT"/>
            <column name="facture_path" type="VARCHAR(255)"/>
            <column name="total_price" type="DECIMAL(10,2)"/>
            <column name="created_at" type="DATETIME"/>
            <column name="is_paid" type="BOOLEAN"/>
            <column name="is_finished" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 5. Table order_item -->
    <changeSet author="kilane dounia" id="5">
        <createTable tableName="order_item">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="article_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="order_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="cart_id" type="INT"/>
            <column name="price" type="DECIMAL(10,2)"/>
            <column name="quantity_kg" type="DECIMAL(10,2)"/>
            <column name="quantity" type="DECIMAL(10,2)"/>
            <column name="scanned_at" type="DATETIME"/>
            <column name="is_scanned" type="BOOLEAN" defaultValueBoolean="false">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <!-- 6. Table delivery_status -->
    <changeSet author="kilane dounia" id="6">
        <createTable tableName="delivery_status">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="label" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

    <!-- 7. Table delivery -->
    <changeSet author="kilane dounia" id="7">
        <createTable tableName="delivery">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="order_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="user_id" type="INT"/>
            <column name="delivery_status_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="delivery_date" type="DATETIME"/>
            <column name="delivered_at" type="DATETIME"/>
            <column name="scanned_at" type="DATETIME"/>
            <column name="tracking_url" type="VARCHAR(255)"/>
            <column name="comment" type="TEXT"/>
            <column name="doorstep" type="BOOLEAN"/>
            <column name="signature" type="BLOB"/>
        </createTable>
    </changeSet>

    <!-- 8. Table delivery_picture -->
    <changeSet author="kilane dounia" id="8">
        <createTable tableName="delivery_picture">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true"/>
            </column>
            <column name="delivery_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="picture_path" type="VARCHAR(50)"/>
        </createTable>
    </changeSet>

    <!-- 9–15. Foreign keys -->
    <changeSet author="kilane dounia" id="9">
        <addForeignKeyConstraint baseTableName="article" baseColumnNames="category_id"
                                 referencedTableName="category" referencedColumnNames="id"
                                 constraintName="fk_article_category"/>
    </changeSet>

    <changeSet author="kilane dounia" id="10">
        <addForeignKeyConstraint baseTableName="article" baseColumnNames="family_id"
                                 referencedTableName="family" referencedColumnNames="id"
                                 constraintName="fk_article_family"/>
    </changeSet>

    <changeSet author="kilane dounia" id="11">
        <addForeignKeyConstraint baseTableName="order_item" baseColumnNames="article_id"
                                 referencedTableName="article" referencedColumnNames="id"
                                 constraintName="fk_orderitem_article"/>
    </changeSet>

    <changeSet author="kilane dounia" id="12">
        <addForeignKeyConstraint baseTableName="order_item" baseColumnNames="order_id"
                                 referencedTableName="order" referencedColumnNames="id"
                                 constraintName="fk_orderitem_order"/>
    </changeSet>

    <changeSet author="kilane dounia" id="13">
        <addForeignKeyConstraint baseTableName="delivery" baseColumnNames="order_id"
                                 referencedTableName="order" referencedColumnNames="id"
                                 constraintName="fk_delivery_order"/>
    </changeSet>

    <changeSet author="kilane dounia" id="14">
        <addForeignKeyConstraint baseTableName="delivery" baseColumnNames="delivery_status_id"
                                 referencedTableName="delivery_status" referencedColumnNames="id"
                                 constraintName="fk_delivery_status"/>
    </changeSet>

    <changeSet author="kilane dounia" id="15">
        <addForeignKeyConstraint baseTableName="delivery_picture" baseColumnNames="delivery_id"
                                 referencedTableName="delivery" referencedColumnNames="id"
                                 constraintName="fk_deliverypicture_delivery"/>
    </changeSet>
    <!-- 16. Table review -->
    <changeSet author="kilane dounia" id="16">
        <createTable tableName="review">
            <column name="id" type="INT" autoIncrement="true">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="user_id" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="id_order" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="rating" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="comment" type="TEXT"/>
            <column name="created_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
            <column name="updated_at" type="DATETIME" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
    </changeSet>

    <!-- 17. Foreign key: review -> order -->
    <changeSet author="kilane dounia" id="17">
        <addForeignKeyConstraint
                baseTableName="review"
                baseColumnNames="id_order"
                referencedTableName="order"
                referencedColumnNames="id"
                constraintName="fk_review_order"/>
    </changeSet>

    <!-- 18. Foreign key: review -> user -->
    <changeSet author="kilane dounia" id="18">
        <addForeignKeyConstraint
                baseTableName="review"
                baseColumnNames="user_id"
                referencedTableName="user"
                referencedColumnNames="id"
                constraintName="fk_review_user"/>
    </changeSet>
</databaseChangeLog>
